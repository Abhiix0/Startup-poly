{
  "name": "startupoly-scoreboard",
  "version": "1.0.0",
  "type": "module",
  "description": "Live scoreboard and game management system for STARTUPOLY live event.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:revoke": "tsx scripts/revoke-admin.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > supabase/.temp/database.generated.ts",
    "test:concurrency": "vitest run --config supabase/tests/concurrency/vitest.config.ts",
    "test:security": "vitest run --config supabase/tests/concurrency/vitest.config.ts security",
    "test:contract": "vitest run --config supabase/tests/concurrency/vitest.config.ts contract",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "test:upgrade": "tsx scripts/test-upgrade-path.ts",
    "test:db-suites": "tsx scripts/run-db-suites.ts",
    "verify:prod": "tsx scripts/verify-prod.ts",
    "build:migrations": "tsx scripts/build-all-migrations.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.0.7"
  }
}
